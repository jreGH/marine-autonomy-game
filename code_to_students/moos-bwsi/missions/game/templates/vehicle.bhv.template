// Auto-generated by gen_mission.py — do not edit by hand.
// Vehicle: ${VEHICLE_NAME}  |  Team: ${TEAM_NAME}
//
// MOOS variables this file reads (set by pChallenge):
//   DEPLOY         – true/false  – master on/off
//   CLOSE          – true/false  – chase mode on/off
//   LOITER         – true/false  – explicit patrol request
//   CHASE_UPDATES  – string      – "contact=<name>"  →  BHV_CutRange target
//
// Students: edit pChallenge/Challenge.cpp to change the autonomy logic.
// Do NOT edit this file unless you want to change behavior parameters.

initialize  DEPLOY = false
initialize  CLOSE  = false

//------------------------------------------
// Mode declarations
//------------------------------------------

Set MODE = Active {
  DEPLOY = true
} Inactive

Set MODE = Chasing {
  MODE  = Active
  CLOSE = true
} Patrolling

//------------------------------------------
// Safety behaviors (always active)
//------------------------------------------

Behavior = BHV_OpRegion
{
  name      = op_region
  pwt       = 300
  condition = MODE == Active

  polygon        = ${ARENA_POLYGON}
  trigger_entry_time  = 1
  trigger_exit_time   = 1

  visual_hints = edge_color=red, edge_size=2, vertex_color=red, vertex_size=4
}

Behavior = BHV_AvoidCollision
{
  name      = avoid_collision
  pwt       = 200
  condition = MODE == Active
  updates   = AVOID_COLLISION_UPDATES

  contact_type_required = any
  pwt_inner_dist        = 6
  pwt_outer_dist        = 30
  completed_dist        = 50
  min_util_cpa_dist     = 5
  max_util_cpa_dist     = 20
  turn_towards_contact  = false
  visual_hints = edge_color = white
}

//------------------------------------------
// Chase behavior
//------------------------------------------

Behavior = BHV_CutRange
{
  name      = chase
  pwt       = 150
  condition = MODE == Chasing
  updates   = CHASE_UPDATES

  contact       = nobody         // overridden by CHASE_UPDATES
  pwt_outer_dist = 80
  pwt_inner_dist = 5
  giveup_dist    = 120
  pursueit_dist  = 100

  visual_hints = edge_color=${VEHICLE_COLOR}, edge_size=1
  visual_hints = vertex_color=${VEHICLE_COLOR}, vertex_size=4
}

//------------------------------------------
// Patrol behavior
//------------------------------------------

Behavior = BHV_Loiter
{
  name      = patrol
  pwt       = 100
  condition = MODE == Patrolling
  updates   = LOITER_UPDATES

  polygon        = ${PATROL_POLYGON}
  clockwise      = true
  speed          = 1.5
  radius         = 10
  nm_radius      = 15
  center_activate = true

  visual_hints = edge_color=${VEHICLE_COLOR}, edge_size=1
  visual_hints = vertex_color=${VEHICLE_COLOR}, vertex_size=3
}
