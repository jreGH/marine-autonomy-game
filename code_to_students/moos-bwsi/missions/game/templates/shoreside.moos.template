// Auto-generated by gen_mission.py — do not edit by hand.
// Shoreside community: referee, viewer, and inter-community broker.

ServerHost   = localhost
ServerPort   = ${SHORESIDE_PORT}
Community    = shoreside
MOOSTimeWarp = 1

LatOrigin  = ${LAT_ORIGIN}
LongOrigin = ${LON_ORIGIN}

//------------------------------------------
ProcessConfig = ANTLER
{
  MSBetweenLaunches = 200

  Run = MOOSDB                  @ NewConsole = false
  Run = pMarineViewer           @ NewConsole = false
  Run = pChallenge_shoreside    @ NewConsole = false
  Run = uFldShoreBroker         @ NewConsole = false
  Run = pShare                  @ NewConsole = false
  Run = uProcessWatch           @ NewConsole = false
}

//------------------------------------------
// pMarineViewer — the main GUI
ProcessConfig = pMarineViewer
{
  AppTick    = 4
  CommsTick  = 4

  tiff_file            = ${TIFF_FILE}
  set_pan_x            = -90
  set_pan_y            = 0
  zoom                 = 0.5
  vehicle_shape_scale  = 1.5
  hash_delta           = 500
  hash_shade           = 0.22
  hash_viewable        = false
  trails_point_size    = 1

  // Appcast panel
  appcast_height       = 75
  appcast_width        = 30
  appcast_viewable     = true
  appcast_color_scheme = indigo
  nodes_font_size      = medium
  procs_font_size      = medium
  appcast_font_size    = small

  // Scope variables visible in the data panel
  scope = NODE_REPORT
  scope = VIEW_POLYGON
  scope = VIEW_SEGLIST
  scope = VIEW_POINT

  // GUI buttons
  button_one = DEPLOY  # DEPLOY_ALL=true
  button_two = HALT    # DEPLOY_ALL=false
}

//------------------------------------------
ProcessConfig = pChallenge_shoreside
{
  AppTick   = 4
  CommsTick = 4

  game_length    = ${GAME_LENGTH_MIN}
  whale_score    = ${WHALE_SCORE}
  fish_score     = ${FISH_SCORE}
  pickup_score   = ${PICKUP_SCORE}
  collect_score  = ${COLLECT_SCORE}
  bite_timeout   = ${BITE_TIMEOUT}
}

//------------------------------------------
// uFldShoreBroker: receives registration packets from uFldNodeBroker
// on each vehicle/NPC community and automatically sets up pShare bridges.
ProcessConfig = uFldShoreBroker
{
  AppTick    = 1
  CommsTick  = 1

  // Variables to push from shoreside → every registered vehicle
  qbridge = DEPLOY_ALL
  qbridge = MOOS_MANUAL_OVERRIDE

  // Per-vehicle variables (the broker adds the vehicle-name suffix automatically)
  bridge  = src=DEPLOY_ALL, alias=DEPLOY

  // Receive NODE_REPORTs from all communities and re-publish locally
  // so pMarineViewer can display all vehicles on one map
  note = NODE_REPORT
}

//------------------------------------------
ProcessConfig = pShare
{
  AppTick   = 2
  CommsTick = 2

  input = route=localhost:${SHARE_LISTEN_PORT}
}

//------------------------------------------
ProcessConfig = uProcessWatch
{
  AppTick   = 4
  CommsTick = 4
  watch_all = true
  nowatch   = uPokeDB*
  nowatch   = uXMS*
}
