//---------------------------------------------------
// Helm Behavior file 
initialize   DEPLOY  = false
initialize   RETURN  = false
initialize   STATION_KEEP = false
initialize   LOITER  = true

set MODE = ACTIVE {
  DEPLOY = true
} INACTIVE

set MODE = STATION-KEEPING {
  MODE = ACTIVE
  STATION_KEEP = true
}                       

set MODE = RETURNING {
  MODE = ACTIVE
  RETURN = true
} 

set MODE = LOITERING {
  MODE = ACTIVE
  LOITER = true
} 

//----------------------------------------------
Behavior = BHV_Loiter
{
  name      = loiter
  pwt       = 100
  condition = MODE==LOITERING

  ipf_type = zaic_spd
	
   post_suffix = A
         speed = 1.4
     clockwise = false
        radius = 8.0
     nm_radius = 15.0
       polygon = radial:: $(LOITER_POS), radius=10, pts=8, snap=1, label=$(AUV_NAME)_LOITER
//  repeat=forever
  visual_hints = nextpt_color=white, nextpt_lcolor=khaki
  visual_hints = edge_color=orange, vertex_color=white
  visual_hints = edge_size=1, vertex_size=2
}

//----------------------------------------------
Behavior = BHV_MaxSpeed
{
  name      = max_spd
    pwt       = 500
  updates   = MAX_SPEED_UPDATES
    condition = MODE==ACTIVE

    max_speed = 2.4
    tolerance = 0.2
}

Behavior = BHV_ConstantSpeed
{
   // General Behavior Parameters
   // ---------------------------
   name         = const_spd_transit  // example
   pwt          = 100                // default
   condition    = MODE==ACTIVE   // example
   updates      = CONST_SPD_UPDATES  // example

   // Parameters specific to this behavior
   // ------------------------------------
            basewidth = 0.2          // default
             duration = 100000            // default
                speed = 2.0            // default
   speed_mismatch_var = SPEED_DIFF   // example
            peakwidth = 0            // default
          summitdelta = 0            // default
}

Behavior = BHV_ConstantDepth
{
   // General Behavior Parameters
   // ---------------------------
   name         = const_depth  // example
   pwt          = 100                // default
   condition    = MODE==ACTIVE   // example
   updates      = CONST_DEPTH_UPDATES  // example

   // Parameters specific to this behavior
   // ------------------------------------
            basewidth = 0.2          // default
             duration = 100000            // default
                depth = 42.0            // default
   depth_mismatch_var = DEPTH_DIFF   // example
            peakwidth = 0            // default
          summitdelta = 0            // default
}

//----------------------------------------------
Behavior = BHV_Waypoint
{
  name      = waypt_return
  pwt       = 100
  updates   = RETURN_UPDATES
  condition = MODE==RETURNING
  endflag   = STATION_KEEP = true
  endflag   = CLOSE = false

      speed = 1.3
     radius = 3.0
  nm_radius = 15.0
     point =  0,0
     repeat = 10
       lead = 8
}

//----------------------------------------------
Behavior = BHV_StationKeep
{
  name         = station-keep
  pwt          = 100
  condition    = MODE==STATION-KEEPING
  inactiveflag = STATIONING = false
  activeflag   = STATIONING = true

     center_activate = true
        inner_radius = 5
        outer_radius = 10 
         outer_speed = 1.0

       transit_speed = 1.3
          swing_time = 7
        visual_hints = vertex_size=0, edge_color=gray50
}

//----------------------------------------------
Behavior = BHV_ConstantDepth
{

	// General
	//-----------------------------
	name = survey_depth
	pwt = 100
	condition = MODE==LOITERING
	updates = DEPTH_UPDATES

	// Parameters specific to this behavior
   	// ------------------------------------
                depth = 100            // default
   depth_mismatch_var = DEPTH_DIFF   // example
             duration = no-time-limit            // default
}
