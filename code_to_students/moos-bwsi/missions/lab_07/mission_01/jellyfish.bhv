//--------    FILE: jellyfish.bhv   -------------
initialize DEPLOY = false
initialize RETURN = false
initialize FIRST_POSITION = true

//---------------------------------------------
// Behavior logic
// o ROOT
// |--o INACTIVE
// |--o ACTIVE
//    |--o STATIONKEEPING
//    |--o LOITERING
//       |--o POSITION_ONE
//       |--o POSITION_TWO

Set MODE = ACTIVE {
  DEPLOY = true
} INACTIVE

Set MODE = LOITERING {
  MODE = ACTIVE
  RETURN = false
}

Set MODE = POSITION_ONE {
  MODE = ACTIVE:LOITERING
  RETURN = false
  FIRST_POSITION = true
} POSITION_TWO

Set MODE = STATIONKEEPING {
  MODE = ACTIVE
  RETURN = true
}


//----------------------------------------------
Behavior=BHV_Waypoint
{ 
  name      = watch_one
  pwt       = 100
  condition = MODE == POSITION_ONE
  endflag   = FIRST_POSITION = false

  updates    = WPT_UPDATE
  perpetual  = true

                lead = 8
         lead_damper = 1
       lead_to_start = true
               speed = 12   // meters per second
        capture_line = true
      capture_radius = 5.0
         slip_radius = 15.0
  efficiency_measure = all

		   	points = format=radial, label=watch_one, x=20, y=-340, radius=60, pts=6, snap=1

               order = normal
             repeat  = 0

    visual_hints = nextpt_color=yellow
    visual_hints = nextpt_vertex_size=8
    visual_hints = nextpt_lcolor=gray70
    visual_hints = vertex_color=dodger_blue, edge_color=white
    visual_hints = vertex_size=5, edge_size=1
}

//----------------------------------------------
Behavior=BHV_Waypoint
{
  name      = watch_two
  pwt       = 100
  condition = MODE == POSITION_TWO
  endflag   = RETURN = true

  updates    = WPT_UPDATE
  perpetual  = true

                lead = 8
         lead_damper = 1
       lead_to_start = true
               speed = 12   // meters per second
        capture_line = true
      capture_radius = 5.0
         slip_radius = 15.0
  efficiency_measure = all

            points = format=radial, label=watch_two, x=100, y=140, radius=100, pts=12, snap=1

               order = normal
             repeat  = 0

    visual_hints = nextpt_color=yellow
    visual_hints = nextpt_vertex_size=8
    visual_hints = nextpt_lcolor=gray70
    visual_hints = vertex_color=dodger_blue, edge_color=white
    visual_hints = vertex_size=5, edge_size=1
}

Behavior = BHV_StationKeep
{
   // General Behavior Parameters
   // ---------------------------
   name         = station-keep          // example
   pwt          = 100                   // default
   condition    = MODE == STATIONKEEPING
   endflag      = RETURN =false
   endflag      = FIRST_POSITION = true
   duration     = 300

   // Parameters specific to this behavior
   // ------------------------------------
      center_activate = false   // default
   hibernation_radius = -1      // default
         inner_radius = 4       // default
         outer_radius = 15      // default
         outer_speed  = 1.2     // default
       transit_speed  = 2.5     // default
           station_pt = 0,0     // default
           swing_time = 0       // default

         visual_hints = vertex_size  = 1           // default
         visual_hints = edge_color   = light_blue  // default
         visual_hints = edge_size    = 1           // default
         visual_hints = label_color  = white       // default
         visual_hints = vertex_color = red         // default
}


//----------------------------------------------
Behavior=BHV_ConstantSpeed
{
  name       = const_speed
  pwt        = 200
  condition  = SPD=true
  condition  = DEPLOY = true
  perpetual  = true
  updates    = SPEED_UPDATE
  endflag    = SPD = false

     speed = 0.5
		 duration = 10
		 duration_reset = CONST_SPD_RESET=true
	
}

