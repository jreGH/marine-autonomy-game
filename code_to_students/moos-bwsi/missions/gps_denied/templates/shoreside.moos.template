// Auto-generated by gen_gps_denied.py — do not edit by hand.
// Shoreside: beacon oracle, viewer, and inter-community broker.

ServerHost   = ${SHORESIDE_HOST}
ServerPort   = ${SHORESIDE_PORT}
Community    = shoreside
MOOSTimeWarp = 1

LatOrigin  = ${LAT_ORIGIN}
LongOrigin = ${LON_ORIGIN}

//------------------------------------------
ProcessConfig = ANTLER
{
  MSBetweenLaunches = 200

  Run = MOOSDB                    @ NewConsole = false
${VIEWER_RUN_LINE}  Run = uFldBeaconRangeSensor     @ NewConsole = false
  Run = uFldShoreBroker           @ NewConsole = false
  Run = pShare                    @ NewConsole = false
  Run = uProcessWatch             @ NewConsole = false
}

${VIEWER_CONFIG_BLOCK}
//------------------------------------------
// uFldBeaconRangeSensor: acoustic beacon simulator.
// Vehicles receive BEACON_RANGE_REPORT when within push_dist of a beacon.
ProcessConfig = uFldBeaconRangeSensor
{
  AppTick   = 4
  CommsTick = 4

${BEACON_BLOCKS}

  default_beacon_push_dist  = ${PUSH_DIST}
  default_beacon_pull_dist  = ${PULL_DIST}
  default_beacon_freq       = ${BEACON_FREQ}
  default_beacon_shape      = circle
  default_beacon_color      = blue
  default_beacon_width      = 4

  rn_algorithm            = uniform
  rn_uniform_magnitude    = ${NOISE_MAGNITUDE}
}

//------------------------------------------
ProcessConfig = uFldShoreBroker
{
  AppTick    = 1
  CommsTick  = 1

  qbridge = DEPLOY_ALL
  qbridge = MOOS_MANUAL_OVERRIDE

  bridge = src=DEPLOY_ALL, alias=DEPLOY

  // Bridge beacon range reports down to each vehicle
${BEACON_BRIDGE_LINES}

}

//------------------------------------------
ProcessConfig = pShare
{
  AppTick   = 2
  CommsTick = 2

  input = route=${SHORESIDE_HOST}:${SHARE_LISTEN_PORT}

  // Static routes: push DEPLOY_ALL to every vehicle community as DEPLOY
${VEHICLE_SHARE_OUTPUTS}
}

//------------------------------------------
ProcessConfig = uProcessWatch
{
  AppTick   = 4
  CommsTick = 4
  watch_all = true
  nowatch   = uPokeDB*
  nowatch   = uXMS*
}
