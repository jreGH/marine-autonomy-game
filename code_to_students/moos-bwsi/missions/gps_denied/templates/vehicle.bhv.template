// Auto-generated by gen_gps_denied.py — do not edit by hand.
// Vehicle: ${VEHICLE_NAME}  |  Team: ${TEAM_NAME}
//
// MOOS variables (set by Python student script or pChallenge):
//   DEPLOY         – true/false  – master on/off
//   CLOSE          – true/false  – chase mode      → api.chase()
//   GO_TO          – true/false  – waypoint mode   → api.go_to()
//   DEPTH_UPDATES  – string      – "depth=<n>"     → api.set_depth()
//
// Variables arriving from uFldBeaconRangeSensor (via pShare):
//   BEACON_RANGE_REPORT  – "label=beacon_01,dist=42.3"
//
// BHV_PeriodicSurface manages ascent/descent automatically.
// The helm suspends horizontal behaviours during ascent/descent.

initialize  DEPLOY = false
initialize  CLOSE  = false
initialize  GO_TO  = false

//------------------------------------------
Set MODE = Active {
  DEPLOY = true
} Inactive

Set MODE = Chasing {
  MODE  = Active
  CLOSE = true
} GoingTo

Set MODE = GoingTo {
  MODE  = Active
  GO_TO = true
} Patrolling

//------------------------------------------
// Safety: stay inside arena
Behavior = BHV_OpRegion
{
  name      = op_region
  pwt       = 300
  condition = MODE == Active

  polygon            = ${ARENA_POLYGON}
  trigger_entry_time = 1
  trigger_exit_time  = 1

  visual_hints = edge_color=red, edge_size=2, vertex_color=red, vertex_size=4
}

//------------------------------------------
// Collision avoidance
Behavior = BHV_AvoidCollision
{
  name      = avoid_collision
  pwt       = 200
  condition = MODE == Active
  updates   = AVOID_COLLISION_UPDATES

  contact_type_required = any
  pwt_inner_dist        = 6
  pwt_outer_dist        = 30
  completed_dist        = 50
  min_util_cpa_dist     = 5
  max_util_cpa_dist     = 20
  turn_towards_contact  = false
}

//------------------------------------------
// Periodic surface: ascend for GPS fix every surface_period seconds.
// pwt=300 overrides horizontal behaviours during ascent/descent.
Behavior = BHV_PeriodicSurface
{
  name      = periodic_surface
  pwt       = 300
  condition = MODE == Active

  period              = ${SURFACE_PERIOD}
  atsurface_depth     = 0.5
  ascent_speed        = 1.5
  descent_speed       = 1.5
  max_time_at_surface = ${SURFACE_TIME}

  // Publish a flag when at surface so the student script knows GPS is valid
  atflag = VEHICLE_AT_SURFACE=true
  bflag  = VEHICLE_AT_SURFACE=false
}

//------------------------------------------
// Depth hold at search depth while submerged
Behavior = BHV_ConstantDepth
{
  name      = hold_depth
  pwt       = 100
  condition = MODE == Active
  updates   = DEPTH_UPDATES

  depth         = ${SEARCH_DEPTH}
  peakwidth     = 4
  basewidth     = 12
  summitdelta   = 2
}

//------------------------------------------
// Waypoint navigation (api.go_to / api.go_to_sequence)
Behavior = BHV_Waypoint
{
  name      = go_to
  pwt       = 150
  condition = MODE == GoingTo
  updates   = WPT_UPDATE
  endflag   = GO_TO=false

  points     = 0,0
  speed      = 1.5
  radius     = 5
  nm_radius  = 8
  repeat     = 0

  visual_hints = edge_color=${VEHICLE_COLOR}, edge_size=1
  visual_hints = vertex_color=${VEHICLE_COLOR}, vertex_size=3
}

//------------------------------------------
// Chase (horizontal range closing)
Behavior = BHV_CutRange
{
  name      = chase
  pwt       = 150
  condition = MODE == Chasing
  updates   = CHASE_UPDATES

  contact        = nobody
  pwt_outer_dist = 80
  pwt_inner_dist = 5
  giveup_dist    = 120

  visual_hints = edge_color=${VEHICLE_COLOR}, edge_size=1
}

//------------------------------------------
// Default: lawnmower patrol of the search box
Behavior = BHV_Loiter
{
  name      = patrol
  pwt       = 100
  condition = MODE == Patrolling
  updates   = LOITER_UPDATES

  polygon        = ${SEARCH_POLYGON}
  clockwise      = true
  speed          = 1.5
  radius         = 10
  nm_radius      = 15
  center_activate = true

  visual_hints = edge_color=${VEHICLE_COLOR}, edge_size=1
  visual_hints = vertex_color=${VEHICLE_COLOR}, vertex_size=3
}
