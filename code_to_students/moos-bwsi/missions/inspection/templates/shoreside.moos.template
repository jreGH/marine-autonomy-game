// Auto-generated by gen_inspection.py — do not edit by hand.
// Shoreside community: sensor oracle, viewer, and inter-community broker.

ServerHost   = localhost
ServerPort   = ${SHORESIDE_PORT}
Community    = shoreside
MOOSTimeWarp = 1

LatOrigin  = ${LAT_ORIGIN}
LongOrigin = ${LON_ORIGIN}

//------------------------------------------
ProcessConfig = ANTLER
{
  MSBetweenLaunches = 200

  Run = MOOSDB                  @ NewConsole = false
  Run = pMarineViewer           @ NewConsole = false
  Run = pInfrastructureSensor   @ NewConsole = false
  Run = pInspectionScorer       @ NewConsole = false
  Run = uFldShoreBroker         @ NewConsole = false
  Run = pShare                  @ NewConsole = false
  Run = uProcessWatch           @ NewConsole = false
}

//------------------------------------------
ProcessConfig = pMarineViewer
{
  AppTick    = 4
  CommsTick  = 4

  tiff_file            = ${TIFF_FILE}
  set_pan_x            = -90
  set_pan_y            = 0
  zoom                 = 0.5
  vehicle_shape_scale  = 1.5
  hash_delta           = 500
  hash_shade           = 0.22
  hash_viewable        = false
  trails_point_size    = 1

  appcast_height       = 75
  appcast_width        = 30
  appcast_viewable     = true
  appcast_color_scheme = indigo
  nodes_font_size      = medium
  procs_font_size      = medium
  appcast_font_size    = small

  scope = NODE_REPORT
  scope = VIEW_POLYGON
  scope = VIEW_SEGLIST
  scope = VIEW_POINT
  scope = INFRASTRUCTURE_DETECT_JELLYFISH
  scope = INFRASTRUCTURE_DETECT_SQUID

  button_one = DEPLOY  # DEPLOY_ALL=true
  button_two = HALT    # DEPLOY_ALL=false
}

//------------------------------------------
ProcessConfig = pInfrastructureSensor
{
  AppTick   = 4
  CommsTick = 4

${PIPELINE_BLOCKS}
${ANOMALY_BLOCKS}

  detect_range  = ${DETECT_RANGE}
  detect_cone   = ${DETECT_CONE}
  noise_sigma   = ${NOISE_SIGMA}
  p_false_alarm = ${P_FALSE_ALARM}
  reveal_pipe   = ${REVEAL_PIPE}
}

//------------------------------------------
// pInspectionScorer: mirrors pipeline/anomaly config from pInfrastructureSensor
ProcessConfig = pInspectionScorer
{
  AppTick   = 4
  CommsTick = 4

${PIPELINE_BLOCKS}
${ANOMALY_BLOCKS}

  coverage_radius     = ${DETECT_RANGE}
  coverage_score      = ${COVERAGE_SCORE}
  coverage_threshold  = ${COVERAGE_THRESHOLD}
  anomaly_score       = ${ANOMALY_SCORE}
  false_alarm_penalty = ${FALSE_ALARM_PENALTY}
  report_tolerance    = 15.0
  sample_step         = 5.0
}

//------------------------------------------
ProcessConfig = uFldShoreBroker
{
  AppTick    = 1
  CommsTick  = 1

  qbridge = DEPLOY_ALL
  qbridge = MOOS_MANUAL_OVERRIDE

  bridge = src=DEPLOY_ALL, alias=DEPLOY

  // Bridge detection reports down to each vehicle community
${DETECT_BRIDGE_LINES}

  note = NODE_REPORT
}

//------------------------------------------
ProcessConfig = pShare
{
  AppTick   = 2
  CommsTick = 2

  input = route=localhost:${SHARE_LISTEN_PORT}
}

//------------------------------------------
ProcessConfig = uProcessWatch
{
  AppTick   = 4
  CommsTick = 4
  watch_all = true
  nowatch   = uPokeDB*
  nowatch   = uXMS*
}
