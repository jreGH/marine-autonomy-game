//--------    FILE: jellyfish.bhv   -------------



//---------------------------------------------
// Behavior logic

//----------------------------------------------
Behavior=BHV_Waypoint
{ 
  name      = watch_one
  pwt       = 100
  condition = 
  endflag   = 

  updates    = WPT_UPDATE
  perpetual  = true

                lead = 8
         lead_damper = 1
       lead_to_start = true
               speed = 12   // meters per second
        capture_line = true
      capture_radius = 5.0
         slip_radius = 15.0
  efficiency_measure = all

		   	points = format=radial, label=watch_one, x=20, y=-340, radius=60, pts=6, snap=1

               order = normal
             repeat  = 0

    visual_hints = nextpt_color=yellow
    visual_hints = nextpt_vertex_size=8
    visual_hints = nextpt_lcolor=gray70
    visual_hints = vertex_color=dodger_blue, edge_color=white
    visual_hints = vertex_size=5, edge_size=1
}

