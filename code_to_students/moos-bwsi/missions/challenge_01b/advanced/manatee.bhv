//--------    FILE: manatee.bhv   -------------

initialize   DEPLOY = false
initialize   WAITING = false

//---------------------------------------------
// Behavior logic
Set MODE=GO{
    DEPLOY = true
	WAITING = false
} WAIT

//---------------------------------------------------
// Behaviors to update
//---------------------------------------------------
Behavior = BHV_ConstantHeading
{
	// General Behavior Parameters
	// ---------------------------
	name         = const_hdg            // example
	pwt          = 100                  // default
	condition    = MODE == GO           // example
	updates      = HEADING_UPDATE    // example

	// Parameters specific to this behavior
	// ------------------------------------
	basewidth = 10           // default
	duration = no-time-limit // keep this beering forever
	//speed = 8                // default
	heading_mismatch_var = HDG_DIFF     // variable to post heading error
	peakwidth = 10           // default
	summitdelta = 25           // default
}

//----------------------------------------------------------
// waiting behavior

Behavior = BHV_Loiter
{
	// General Behavior Parameters
    // ---------------------------
    name         = wait             // 
    pwt          = 100              // default
    condition    = MODE==WAIT       //
    updates      = LOITER_UPDATE    // 

    // Parameters specific to this behavior
    // ------------------------------------
    	acquire_dist = 10               // 
      capture_radius = 3                //   
     center_activate = true            // 
           clockwise = true             // 
         slip_radius = 15               // 
               speed = 8                // 
       spiral_factor = 90               // BWSI EDIT

             polygon = radial:: x=5,y=8,radius=20,pts=8  // example
         post_suffix = manatee                             // BWSI EDIT

      // center_assign = 40,50            // example
      // xcenter_assign = 40               // example
      // ycenter_assign = 50               // example


        visual_hints = vertex_size  = 1             // default
        visual_hints = edge_size    = 1             // default
        visual_hints = vertex_color = dodger_blue   // default
        visual_hints = edge_color   = white         // default
        visual_hints = nextpt_color = yellow        // default
        visual_hints = nextpt_lcolor = aqua         // default
        visual_hints = nextpt_vertex_size = 5       // default
        visual_hints = label        = zone3         // example
}

//----------------------------------------------
// Perpetual behaviors while DEPLOY=true
//--------------------------------------------

// Operating Region
Behavior = BHV_OpRegion
{
	// General Behavior Parameters
	// ---------------------------
	name         = op_region                 // example
	pwt          = 100                       // default
	condition    = DEPLOY=true               // example
	//updates    = // No updates

	// Parameters specific to this behavior
	// ------------------------------------
	max_time = 300              // default (seconds)
	max_depth = 0              // default (meters)
	min_altitude = 0              // default (meters)
	reset_var = OPREGION_RESET // example
	trigger_entry_time = 1              // default (seconds)
	trigger_exit_time = 0.5            // default (seconds) 

	polygon = pts={-75,-325:-75,-100:200,75:200,-325}, label=BWSI_FIELD

	breached_altitude_flag = SAY_MOOS = Sir, the min altitude has been exceeded
	breached_depth_flag = SAY_MOOS = Sir, the max depth has been exceeded
	breached_poly_flag = SAY_MOOS = Sir, the op region has been violated
	breached_time_flag = SAY_MOOS = Sir, the maximum mission time has been exceeded

	visual_hints = vertex_color = brown  // default
	visual_hints = vertex_size  = 3      // default
	visual_hints = edge_color   = aqua   // default
	visual_hints = edge_size    = 1      // default
}

// Running speed
Behavior=BHV_ConstantSpeed
{
	name       = const_speed
	pwt        = 200
	condition  = DEPLOY = true
	perpetual  = true
	updates    = SPEED_UPDATE
	endflag    = SPD = false

	speed = 10
	duration = 10
	duration_reset = CONST_SPD_RESET=true
}

