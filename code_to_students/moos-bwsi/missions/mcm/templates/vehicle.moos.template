// Auto-generated by gen_mcm.py — do not edit by hand.
// Vehicle: ${VEHICLE_NAME}  |  Team: ${TEAM_NAME}

ServerHost   = ${VEHICLE_HOST}
ServerPort   = ${SERVER_PORT}
Community    = ${VEHICLE_NAME}
MOOSTimeWarp = 1

LatOrigin  = ${LAT_ORIGIN}
LongOrigin = ${LON_ORIGIN}

//------------------------------------------
ProcessConfig = ANTLER
{
  MSBetweenLaunches = 200

  Run = MOOSDB              @ NewConsole = false
  Run = pLogger             @ NewConsole = false
  Run = uSimMarine          @ NewConsole = false
  Run = pMarinePID          @ NewConsole = false
  Run = pHelmIvP            @ NewConsole = false
  Run = pNodeReporter       @ NewConsole = false
  Run = pHostInfo           @ NewConsole = false
  Run = uFldNodeBroker      @ NewConsole = false
  Run = pShare              @ NewConsole = false
  Run = uProcessWatch       @ NewConsole = false
}

//------------------------------------------
ProcessConfig = pLogger
{
  AppTick   = 8
  CommsTick = 8
  AsyncLog  = true
  Log = IVPHELM_LIFE_EVENT @ 0 NOSYNC
  WildCardLogging         = true
  WildCardOmitPattern     = *_STATUS
  WildCardOmitPattern     = DB_VARSUMMARY
  WildCardOmitPattern     = DB_RWSUMMARY
  WildCardExclusionLog    = true
}

//------------------------------------------
ProcessConfig = uSimMarine
{
  AppTick    = 4
  CommsTick  = 4

  start_x       = ${START_X}
  start_y       = ${START_Y}
  start_heading = ${START_HEADING}
  start_speed   = 0

  prefix        = NAV

  turn_rate     = 40
  thrust_map    = 0:0, 20:1, 40:2, 60:3, 80:4, 100:5
  thrust_reflect = true
}

//------------------------------------------
ProcessConfig = pMarinePID
{
  AppTick    = 20
  CommsTick  = 20

  verbose       = true
  depth_control = false

  yaw_pid_kp               = 1.2
  yaw_pid_kd               = 0.0
  yaw_pid_ki               = 0.3
  yaw_pid_integral_limit   = 0.07

  speed_pid_kp             = 1.0
  speed_pid_kd             = 0.0
  speed_pid_ki             = 0.0
  speed_pid_integral_limit = 0.07

  maxrudder   = 100
  maxthrust   = 100
  speed_factor = 20
}

//------------------------------------------
ProcessConfig = pHelmIvP
{
  AppTick    = 4
  CommsTick  = 4

  bhv_dir_not_found_ok = true
  behaviors            = ${VEHICLE_NAME}.bhv
  domain               = course:0:359:360
  domain               = speed:0:${MAX_SPEED}:41
}

//------------------------------------------
ProcessConfig = pNodeReporter
{
  AppTick    = 2
  CommsTick  = 2

  platform_type   = AUV
  platform_color  = ${VEHICLE_COLOR}
  platform_length = 4
  group           = ${TEAM_NAME}
}

//------------------------------------------
//------------------------------------------
ProcessConfig = pHostInfo
{
  AppTick   = 1
  CommsTick = 1
  DEFAULT_HOSTIP = localhost
}

//------------------------------------------
// uFldNodeBroker: registers with shoreside and bridges mission variables.
ProcessConfig = uFldNodeBroker
{
  AppTick   = 1
  CommsTick = 1

  try_shore_host = pshare_route=${SHORESIDE_HOST}:${SHORESIDE_SHARE_PORT}

  // Variables bridged from shoreside → this vehicle
  bridge = src=DEPLOY_ALL,                                    alias=DEPLOY
  bridge = src=DEPLOY_${VEHICLE_NAME_UPPER},                  alias=DEPLOY
  bridge = src=MOOS_MANUAL_OVERRIDE_${VEHICLE_NAME_UPPER},    alias=MOOS_MANUAL_OVERRIDE

  // MCM sensor feedback from uFldHazardSensor
  bridge = src=UHZ_DETECTION_REPORT_${VEHICLE_NAME_UPPER},    alias=UHZ_DETECTION_REPORT
  bridge = src=UHZ_CLASSIFY_REPORT_${VEHICLE_NAME_UPPER},     alias=UHZ_CLASSIFY_REPORT
}

//------------------------------------------
ProcessConfig = pShare
{
  AppTick   = 2
  CommsTick = 2

  input = route=${VEHICLE_HOST}:${SHARE_LISTEN_PORT}

  // Push node report to shoreside so pMarineViewer can track this vehicle.
  output = src=NODE_REPORT_LOCAL, route=${SHORESIDE_HOST}:${SHORESIDE_SHARE_PORT}, alias=NODE_REPORT
}

//------------------------------------------
ProcessConfig = uProcessWatch
{
  AppTick   = 4
  CommsTick = 4
  watch_all = true
  nowatch   = uPokeDB*
  nowatch   = uXMS*
}
