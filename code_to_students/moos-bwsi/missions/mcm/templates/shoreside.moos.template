// Auto-generated by gen_mcm.py — do not edit by hand.
// Shoreside community: hazard sensor oracle, metric scorer, and inter-community broker.

ServerHost   = ${SHORESIDE_HOST}
ServerPort   = ${SHORESIDE_PORT}
Community    = shoreside
MOOSTimeWarp = 1

LatOrigin  = ${LAT_ORIGIN}
LongOrigin = ${LON_ORIGIN}

//------------------------------------------
ProcessConfig = ANTLER
{
  MSBetweenLaunches = 200

  Run = MOOSDB                  @ NewConsole = false
${VIEWER_RUN_LINE}  Run = uFldHazardSensor       @ NewConsole = false
  Run = uFldHazardMetric        @ NewConsole = false
  Run = uFldShoreBroker         @ NewConsole = false
  Run = pShare                  @ NewConsole = false
  Run = uProcessWatch           @ NewConsole = false
}

${VIEWER_CONFIG_BLOCK}
//------------------------------------------
// uFldHazardSensor: answers vehicle sensor requests with stochastic
// detection/classification reports based on the ground-truth mine field.
ProcessConfig = uFldHazardSensor
{
  AppTick   = 4
  CommsTick = 4

  // Ground-truth mine field (not revealed to students)
${HAZARD_BLOCKS}

  // Sensor ROC curve
  default_sensor_pd    = ${SENSOR_PD}
  default_sensor_pfa   = ${SENSOR_PFA}
  default_sensor_width = ${SENSOR_WIDTH}
  default_sensor_exp   = ${SENSOR_EXP}

  // Classification model
  default_classify_pd  = ${CLASSIFY_PD}
  classify_period      = ${CLASSIFY_TIME}

  // Visual aids (show swath footprint in pMarineViewer)
  show_hazards         = false
  show_swath           = true
  swath_length         = 25
}

//------------------------------------------
// uFldHazardMetric: scores teams on detection accuracy and time.
ProcessConfig = uFldHazardMetric
{
  AppTick   = 2
  CommsTick = 2

  // Mirror ground truth for scoring
${HAZARD_BLOCKS}

  penalty_missed_hazard   = ${PENALTY_MISSED}
  penalty_false_alarm     = ${PENALTY_FALSE_ALARM}
  max_time                = ${MAX_TIME}
  penalty_max_time_over   = ${PENALTY_MAX_TIME_OVER}
  penalty_max_time_rate   = ${PENALTY_MAX_TIME_RATE}
}

//------------------------------------------
ProcessConfig = uFldShoreBroker
{
  AppTick    = 1
  CommsTick  = 1

  qbridge = DEPLOY_ALL
  qbridge = MOOS_MANUAL_OVERRIDE

  bridge = src=DEPLOY_ALL, alias=DEPLOY

  // Sensor requests come up from vehicles; sensor app responds with
  // DETECTION_REPORT_<VNAME> and CLASSIFY_REPORT_<VNAME> which are
  // bridged back down to each vehicle community.
  qbridge = UHZ_SENSOR_REQUEST
  qbridge = UHZ_CLASSIFY_REQUEST
  qbridge = UHZ_HAZARD_REPORT

  // Bridge detection/classification reports back down to each vehicle
${DETECT_BRIDGE_LINES}

}

//------------------------------------------
ProcessConfig = pShare
{
  AppTick   = 2
  CommsTick = 2

  input = route=${SHORESIDE_HOST}:${SHARE_LISTEN_PORT}
}

//------------------------------------------
ProcessConfig = uProcessWatch
{
  AppTick   = 4
  CommsTick = 4
  watch_all = true
  nowatch   = uPokeDB*
  nowatch   = uXMS*
}
