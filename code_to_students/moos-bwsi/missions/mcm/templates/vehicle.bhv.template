// Auto-generated by gen_mcm.py — do not edit by hand.
// Vehicle: ${VEHICLE_NAME}  |  Team: ${TEAM_NAME}
//
// MCM mission behavior file.
//
// MOOS variables this file reads (set by your autonomy script or VehicleAPI.py):
//   DEPLOY        – true/false  – master on/off
//   GO_TO         – true/false  – explicit waypoint mode on/off  → api.go_to()
//   WPT_UPDATE    – string      – "points=x,y:..."               → waypoint list
//
// MCM sensor variables (subscribed to by your Python script):
//   UHZ_DETECTION_REPORT   – mine detected in sensor swath
//   UHZ_CLASSIFY_REPORT    – classification result (hazard/benign)
//
// To request a sensor pass, your script posts:
//   UHZ_SENSOR_REQUEST = vname=${VEHICLE_NAME}
// To request classification of a contact, your script posts:
//   UHZ_CLASSIFY_REQUEST = vname=${VEHICLE_NAME},label=<m_label>
// To report a confirmed hazard to shoreside (for scoring), post:
//   UHZ_HAZARD_REPORT = vname=${VEHICLE_NAME},label=<m_label>,type=hazard,x=<x>,y=<y>
//
// Survey mode runs the pre-computed lawnmower pattern indefinitely.
// GoingTo mode overrides the survey to navigate to a specific point.
//
// Python students: run student/examples/mcm_survey.py
// Do NOT edit this file unless you want to change behavior parameters.

initialize  DEPLOY = false
initialize  GO_TO  = false

//------------------------------------------
// Mode declarations
//------------------------------------------

Set MODE = Active {
  DEPLOY = true
} Inactive

Set MODE = GoingTo {
  MODE  = Active
  GO_TO = true
} Searching

//------------------------------------------
// Safety behaviors (always active)
//------------------------------------------

Behavior = BHV_OpRegion
{
  name      = op_region
  pwt       = 300
  condition = MODE == Active

  polygon        = ${ARENA_POLYGON}
  trigger_entry_time  = 1
  trigger_exit_time   = 1

  visual_hints = edge_color=red, edge_size=2, vertex_color=red, vertex_size=4
}

Behavior = BHV_AvoidCollision
{
  name      = avoid_collision
  pwt       = 200
  condition = MODE == Active
  updates   = AVOID_COLLISION_UPDATES

  contact_type_required = any
  pwt_inner_dist        = 6
  pwt_outer_dist        = 30
  completed_dist        = 50
  min_util_cpa_dist     = 5
  max_util_cpa_dist     = 20
  turn_towards_contact  = false
  visual_hints = edge_color = white
}

//------------------------------------------
// Survey sweep (lawnmower pattern)
// Automatically covers the entire search area lane by lane.
//------------------------------------------

Behavior = BHV_Waypoint
{
  name      = survey
  pwt       = 100
  condition = MODE == Searching
  updates   = SURVEY_UPDATE

  // Pre-computed lawnmower pattern generated by gen_mcm.py
  points    = ${SURVEY_POINTS}
  speed     = ${SURVEY_SPEED}
  radius    = 8
  nm_radius = 15

  // Repeat indefinitely so vehicles re-sweep after the first pass
  repeat    = -1

  visual_hints = edge_color=${VEHICLE_COLOR}, edge_size=1
  visual_hints = vertex_color=${VEHICLE_COLOR}, vertex_size=3
}

//------------------------------------------
// Explicit waypoint navigation (used by api.go_to())
//------------------------------------------

Behavior = BHV_Waypoint
{
  name      = go_to
  pwt       = 150
  condition = MODE == GoingTo
  updates   = WPT_UPDATE
  endflag   = GO_TO=false

  points     = 0,0         // overridden by WPT_UPDATE
  speed      = ${MAX_SPEED}
  radius     = 5
  nm_radius  = 8
  repeat     = 0

  visual_hints = edge_color=${VEHICLE_COLOR}, edge_size=1
  visual_hints = vertex_color=${VEHICLE_COLOR}, vertex_size=3
}
