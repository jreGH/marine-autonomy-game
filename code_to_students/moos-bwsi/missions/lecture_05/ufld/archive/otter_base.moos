
ServerHost   = localhost
ServerPort   = 9002
Community    = otter
MOOSTimeWarp = 1

// Aerial Singapore
LatOrigin = 1.28631111
LongOrigin = 103.855328


//------------------------------------------
// pHelmIvP config block

ProcessConfig = pHelmIvP
{
  AppTick    = 4
  CommsTick  = 4

  bhv_dir_not_found_ok = true

  behaviors  = otter.bhv
  domain     = course:0:359:360
  domain     = speed:0:4:41
}


//--------------------------------------------
// pShare config block

ProcessConfig = pShare
{
  AppTick = 2
  CommsTick = 2

  input = route = localhost:9002
  output = src_name=NODE*, route = localhost:9000
  output = src_name=VIEW*, route = localhost:9000
  output = src_name=APP*, route = localhost:9000
}

#include moos_plugs/plug_pMarinePID.moos
#include moos_plugs/plug_pNodeReporter.moos
#include moos_plugs/plug_pAntler.moos
#include moos_plugs/plug_pLogger.moos
#include moos_plugs/plug_uMemWatch.moos
#include moos_plugs/plug_uProcessWatch.moos
#include moos_plugs/plug_uSimMarine.moos
