//--------------------------------------------
// pShare config block

ProcessConfig = pShare
{
  AppTick = 2
  CommsTick = 2

  input = route = localhost:9001
  output = src_name=NODE*, route = localhost:9000
  output = src_name=VIEW*, route = localhost:9000
  output = src_name=APP*, route = localhost:9000
}

//--------------------------------------------
// pShare config block

ProcessConfig = pShare
{
  AppTick = 2
  CommsTick = 2

  input = route = localhost:$(AUV_PORT)
  output = src_name=NODE*, route = localhost:$(SHORESIDE_PORT)
  output = src_name=VIEW*, route = localhost:$(SHORESIDE_PORT)
  output = src_name=APP*, route = localhost:$(SHORESIDE_PORT)
}

